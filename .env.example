# Copy to .env and fill in real values. server/src/config/env.js validates all of
# this with zod at boot and refuses to start if anything required is missing or
# malformed — see that file for the authoritative schema.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Shopify ---------------------------------------------------------------
# Scopes are NOT set here — this app uses Shopify-managed installation, so scopes
# live in shopify.app.toml / the Partner Dashboard, not an env var or OAuth param.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.onrender.com
SHOPIFY_WEBHOOK_PATH=/api/webhooks

# --- Firebase / Firestore ---------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key as a single line with literal \n escapes; env.js unescapes
# them to real newlines before initializing firebase-admin.
FIREBASE_PRIVATE_KEY=

# --- fal.ai ------------------------------------------------------------------
FAL_API_KEY=

# --- Brand style extraction LLM (optional — leave unset to disable this feature) -
BRAND_STYLE_LLM_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- WaveSpeed (video) — optional: leave unset to disable video generation ------
WAVESPEED_API_KEY=
WAVESPEED_BASE_URL=

# --- Cloudinary (image hosting/optimization) ---------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend (email) — optional: leave unset to disable nurture/notification emails -
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@example.com

# --- Sentry (optional — leave SENTRY_DSN unset to disable error tracking) -------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Admin panel (admin/ workspace, ADMIN_API_KEY-gated, not a Shopify session) --
ADMIN_API_KEY=

# --- Google OAuth (Sign-In popup flow) ------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-app.onrender.com/api/auth/google/callback

# --- Billing --------------------------------------------------------------------
# Whether appSubscriptionCreate/appPurchaseOneTimeCreate ask Shopify for a TEST
# charge. Defaults to true (never a real charge). Shopify hard-rejects a real
# (test:false) charge against a Partner development store, so keep this "true"
# while testing against dev stores — flip to "false" only once ready to accept
# real payments from real merchants.
BILLING_TEST_MODE=true

# --- Worker / runtime tuning (all have sane defaults if omitted) ---------------
JOB_WORKER_PER_SHOP_CONCURRENCY=20
JOB_WORKER_GLOBAL_CONCURRENCY=40
JOB_LEASE_TIMEOUT_MS=600000
RATE_LIMIT_PER_SHOP_PER_MIN=100
IMAGE_OPTIMIZER_FREE_DAILY_QUOTA=10
